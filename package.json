{
  "name": "ashnight",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:selfhost": "vite build --config vite.config.selfhost.ts",
    "start": "node .output/server/index.mjs",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:sync": "node scripts/mobile-shell-url.mjs && cap sync && node scripts/native-permissions.mjs",
    "mobile:permissions": "node scripts/native-permissions.mjs",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor \"#0b0d12\" --iconBackgroundColorDark \"#0b0d12\" --splashBackgroundColor \"#0b0d12\" --splashBackgroundColorDark \"#0b0d12\"",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:build:android": "bun run mobile:sync && cd android && ./gradlew assembleDebug"
  },
