# Backend (Supabase-compatible) --------------------------------------------
# Browser-visible values. Point these at YOUR backend (self-hosted Supabase,
# e.g. https://api.yourdomain.com, or a hosted Supabase project).
VITE_SUPABASE_URL=https://api.yourdomain.com
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=ashnight

# Server-side copies (used by SSR and server functions). Same URL/key.
SUPABASE_URL=https://api.yourdomain.com
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_PROJECT_ID=ashnight

# Server-only. Bypasses RLS — never expose to the browser, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Runtime ------------------------------------------------------------------
# Port the standalone Node server listens on (cPanel/Passenger sets this for you).
PORT=3000

# NOTE: Paystack keys and call-service credentials are NOT stored here.
# Add them in the admin control room: /ashnight-control/settings ("Keys & security").
# They are stored encrypted-at-rest in the integration_keys table so you can rotate
# them at any time without a redeploy.
